# Copy to .env to change anything. Every value has a working default, so the
# lab runs with no .env at all. These are local-only test values: never reuse
# them anywhere reachable from a network.

# --- Model, for the generative stacks (Holotable, Metabase's Metabot) -------
# Any OpenAI-compatible endpoint. Leave LLM_MODEL empty to run without AI.
#
# Anthropic:  LLM_BASE_URL=https://api.anthropic.com/v1/  LLM_MODEL=claude-opus-5-5
# OpenAI:     LLM_BASE_URL=https://api.openai.com/v1      LLM_MODEL=<model id>
# Ollama on this machine, no key:
#             LLM_BASE_URL=http://host.docker.internal:11434/v1  LLM_MODEL=<pulled model>
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Seed data ---------------------------------------------------------------
# Same seed and same day give the same data. `make reseed` after changing it.
SEED=42
# Seconds between live metric writes.
STREAM_INTERVAL=5

# --- Ports (all bound to 127.0.0.1) ------------------------------------------
WAREHOUSE_PORT=5433
SUPERSET_PORT=8088
SUPERSET_MCP_PORT=5008
GRAFANA_PORT=3001
HOLOTABLE_PORT=3000
METABASE_PORT=3002
RILL_PORT=9009
CUBE_PORT=4000
CUBE_SQL_PORT=15432
STREAMLIT_PORT=3003
MARIMO_PORT=3004
LIGHTDASH_PORT=8080
EVIDENCE_PORT=3005
CLICKHOUSE_PORT=8123
CLICKHOUSE_MCP_PORT=5009
GRAFANA_MCP_PORT=5010
OPENSEARCH_PORT=9200
OPENSEARCH_DASHBOARDS_PORT=5601

# --- Passwords ---------------------------------------------------------------
# Changing one after first start needs `make reset`.
WAREHOUSE_PASSWORD=lab
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=dashlab-local-only-change-me-7c1f0e
GRAFANA_ADMIN_PASSWORD=admin
METABASE_ADMIN_PASSWORD=dashlab-admin-1
HOLOTABLE_SESSION_SECRET=dashlab-local-only-session-secret-0123456789
CUBE_API_SECRET=dashlab-local-only-cube-secret-0123456789
CUBE_SQL_PASSWORD=cube
LIGHTDASH_ADMIN_PASSWORD=dashlab-admin-1
LIGHTDASH_SECRET=dashlab-local-only-lightdash-secret
EVIDENCE_PASSWORD=lab
CLICKHOUSE_PASSWORD=lab
SUPERSET_GUEST_TOKEN_SECRET=dashlab-local-only-guest-token-secret

# --- Stack options -----------------------------------------------------------
# 1 overwrites Holotable's three Lumen Supply dashboards with the specs in
# stacks/holotable/dashboards.py on the next `make up holotable`.
HOLOTABLE_REBUILD=0
# run serves the marimo notebook as an app. edit opens marimo's editor.
MARIMO_MODE=run

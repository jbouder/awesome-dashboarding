          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lab-warehouse"
          },
          "format": "time_series",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), service AS metric, max(p95_latency_ms) AS value\nFROM ops.request_metrics WHERE $__timeFilter(ts)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {

        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Incidents, last 24 hours",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "lab-warehouse"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "lab-warehouse"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT service, kind, started_at, ends_at, now() BETWEEN started_at AND ends_at AS active\nFROM ops.incidents WHERE ends_at > now() - interval '24 hours' ORDER BY started_at DESC"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true
      }
    }
  ],
  "description": "Live service metrics from ops.request_metrics. Run `make incident` to trigger an alert."
}
          "editorMode": "code",
          "rawSql": "SELECT $__timeGroupAlias(ts, $__interval), service AS metric, sum(errors)::float / nullif(sum(requests), 0) AS value\nFROM ops.request_metrics WHERE $__timeFilter(ts)\nGROUP BY 1, 2 ORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
